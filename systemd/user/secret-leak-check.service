[Unit]
Description=Flag credential-shaped strings in local agent logs and caches
Documentation=https://github.com/lowqualityloey/dotfiles
ConditionPathExists=%h/.local/bin/check-secret-leaks

[Service]
Type=oneshot
ExecStart=%h/.local/bin/check-secret-leaks --quiet --notify
# Low priority: this only reads files and never blocks interactive work.
Nice=10
IOSchedulingClass=idle

# Findings make the unit exit non-zero on purpose, so `systemctl --user status
# secret-leak-check` and the journal both show it as failed. That is the signal.
