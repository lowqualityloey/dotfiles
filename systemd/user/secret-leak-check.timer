[Unit]
Description=Daily check for leaked credentials in local logs and caches

[Timer]
# Adjust the cadence here; daily keeps it quiet for a check that only reports.
OnCalendar=daily
# Spread the run so it does not coincide with other daily jobs.
RandomizedDelaySec=1h
# Run on next boot/login if the scheduled time was missed (common under WSL).
Persistent=true

[Install]
WantedBy=timers.target
