#!/usr/bin/env python3
"""Flag credential-shaped strings sitting in local caches and agent session logs.

Designed to run non-interactively (on a systemd timer, from cron, or by hand):
it only reads, prints one line per affected file, and exits non-zero when
anything is found so the scheduler's journal records the failure.

Fix what it finds with:  scrub-secrets --apply

Usage:
    check-secret-leaks              # scan the known tool caches
    check-secret-leaks --quiet      # print nothing when clean
    check-secret-leaks ~/extra/logs # also scan extra paths
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from secret_scan import default_targets, scan, windows_targets  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--quiet", action="store_true",
                        help="only print output when leaks are found")
    parser.add_argument("--notify", action="store_true",
                        help="send a desktop notification when leaks are found")
    parser.add_argument("--include-stores", action="store_true",
                        help="also check tool-managed credential stores")
    parser.add_argument("--no-windows", action="store_true",
                        help="skip Windows-side caches under /mnt/c (WSL only)")
    parser.add_argument("paths", nargs="*", type=Path,
                        help="extra paths to scan (defaults to known tool caches)")
    args = parser.parse_args()

    include_windows = not args.no_windows
    targets = [p.expanduser() for p in args.paths] if args.paths else \
              default_targets(include_windows=include_windows)
    found = scan(targets, args.include_stores)

    if not args.quiet:
        win = windows_targets() if include_windows and not args.paths else []
        scope = f"{len(targets)} location(s)"
        if win:
            scope += f" incl. {len(win)} Windows-side"
        print(f"Scanned {scope}.")

    if not found:
        if not args.quiet:
            print("No credential-shaped strings found.")
        return 0

    print("Credential-shaped strings found in local logs/caches:")
    for path, kind, labels in found:
        print(f"  {path}  [{' + '.join(labels)}]  ({kind})")
    print(f"\n{len(found)} file(s) affected. Run 'scrub-secrets --apply' to redact them.")

    if args.notify:
        notify(f"{len(found)} file(s) with credential-shaped strings (see journalctl "
               "--user -u secret-leak-check)")
    return 1


def notify(message: str) -> None:
    """Best-effort desktop notification; silently does nothing without a bus."""
    import shutil
    import subprocess

    if not shutil.which("notify-send") or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return
    try:
        # capture_output: a missing notification daemon must not pollute the journal
        subprocess.run(
            ["notify-send", "--urgency=critical", "Secret leak check", message],
            check=False, timeout=10, capture_output=True,
        )
    except OSError:
        pass


if __name__ == "__main__":
    raise SystemExit(main())
