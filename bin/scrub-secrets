#!/usr/bin/env python3
"""Redact credential-shaped strings from local caches, agent session logs, and
SQLite stores.

Agent tools (opencode/manicode, cline, gemini, codex, kiro, ...) routinely write
their transcripts and histories to disk. Any token that ever appears in a prompt,
a command line, or a tool result ends up in those files -- they are the last place
secrets linger after you have moved them out of shell rc files.

This walks the known stores, replaces key-shaped strings with a placeholder, and
rewrites SQLite databases in place (secure_delete + WAL checkpoint + VACUUM so the
old bytes do not survive in free pages).

Dry-run by default; pass --apply to write. Legitimate credential stores
(~/.secrets, ~/.zshrc.local, tool-managed auth files) are skipped unless
--include-stores is given. See also: check-secret-leaks.

Usage:
    scrub-secrets                 # report what would change
    scrub-secrets --apply         # actually redact
    scrub-secrets --apply ~/logs  # scan extra paths
"""
from __future__ import annotations

import argparse
import os
import sqlite3
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from secret_scan import (  # noqa: E402
    default_targets, redact_bytes, redact_bytes_samelen, redact_text, scan,
    windows_targets,
)


def redact_sqlite(path: Path, dry_run: bool) -> int:
    conn = sqlite3.connect(str(path), timeout=60)
    conn.execute("PRAGMA secure_delete=ON")
    tables = [r[0] for r in conn.execute(
        "select name from sqlite_master where type='table'")]
    changed = 0
    for table in tables:
        info = list(conn.execute(f'PRAGMA table_info("{table}")'))
        columns = [r[1] for r in info]
        pk = [r[1] for r in info if r[5] > 0]
        if not columns:
            continue
        quoted = ",".join(f'"{c}"' for c in columns)
        for row in conn.execute(f'select {quoted} from "{table}"').fetchall():
            new_row, hit = [], False
            for value in row:
                if isinstance(value, str):
                    new = redact_text(value)
                    hit |= new != value
                    new_row.append(new)
                elif isinstance(value, bytes):
                    new = redact_bytes(value)
                    hit |= new != value
                    new_row.append(new)
                else:
                    new_row.append(value)
            if not hit:
                continue
            changed += 1
            if dry_run:
                continue
            assignments = ",".join(f'"{c}"=?' for c in columns)
            where = " AND ".join(f'"{c}"=?' for c in pk) if pk else \
                    " AND ".join(f'"{c}" IS ?' for c in columns)
            binds = new_row + ([row[columns.index(c)] for c in pk] if pk else list(row))
            conn.execute(f'update "{table}" set {assignments} where {where}', binds)
    if dry_run:
        conn.close()
        return changed
    conn.commit()
    try:
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    except sqlite3.Error:
        pass
    try:
        conn.execute("VACUUM")
    except sqlite3.Error as exc:  # e.g. another process holds the database
        print(f"  note: VACUUM skipped for {path.name}: {exc}", file=sys.stderr)
    conn.commit()
    conn.close()
    return changed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--apply", action="store_true",
                        help="write changes (default is a dry run)")
    parser.add_argument("--include-stores", action="store_true",
                        help="also scrub tool-managed credential stores")
    parser.add_argument("--no-windows", action="store_true",
                        help="skip Windows-side caches under /mnt/c (WSL only)")
    parser.add_argument("paths", nargs="*", type=Path,
                        help="extra paths to scan (defaults to known tool caches)")
    args = parser.parse_args()
    dry_run = not args.apply
    include_windows = not args.no_windows

    targets = [p.expanduser() for p in args.paths] if args.paths else \
              default_targets(include_windows=include_windows)
    found = scan(targets, args.include_stores)
    win = windows_targets() if include_windows and not args.paths else []
    scope = f"{len(targets)} location(s)"
    if win:
        scope += f" incl. {len(win)} Windows-side"
    print(f"Scanning {scope}.")
    text_files = [p for p, kind, _ in found if kind == "text"]
    binary_files = [p for p, kind, _ in found if kind == "binary"]
    sqlite_files = [p for p, kind, _ in found if kind == "sqlite"]

    verb = "would redact" if dry_run else "redacting"
    print(f"{verb}: {len(text_files)} text, {len(binary_files)} binary "
          f"(in-place, length-preserving), {len(sqlite_files)} sqlite")

    for path in text_files:
        print(f"  text   {path}")
        if dry_run:
            continue
        try:
            # surrogateescape round-trips stray bytes in otherwise-text files
            # instead of mangling them the way errors="replace" would.
            with open(path, "r", encoding="utf-8", errors="surrogateescape") as handle:
                original = handle.read()
            updated = redact_text(original)
            if updated != original:
                with open(path, "w", encoding="utf-8", errors="surrogateescape") as handle:
                    handle.write(updated)
        except Exception as exc:  # noqa: BLE001 - one bad file must not abort the run
            print(f"         -> could not rewrite: {exc}", file=sys.stderr)

    for path in binary_files:
        print(f"  binary {path}")
        if dry_run:
            continue
        try:
            data = path.read_bytes()
            updated = redact_bytes_samelen(data)
            if updated != data:
                path.write_bytes(updated)
        except Exception as exc:  # noqa: BLE001 - one bad file must not abort the run
            print(f"         -> could not rewrite: {exc}", file=sys.stderr)

    for path in sqlite_files:
        print(f"  sqlite {path}")
        if dry_run:
            continue
        try:
            cells = redact_sqlite(path, dry_run=False)
            print(f"         -> {cells} row(s) affected")
        except Exception as exc:  # noqa: BLE001 - one bad file must not abort the run
            print(f"         -> could not rewrite: {exc}", file=sys.stderr)

    if dry_run and found:
        print("\nRe-run with --apply to write these changes.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
