# delta (https://github.com/dandavison/delta) as the Git pager.
#
# Kept in the repo and pulled in from ~/.gitconfig via install.sh's `include.path`
# rather than being written into ~/.gitconfig directly, so machine-local identity
# (user.name / user.email) never enters this public repository.
#
# install.sh only adds the include when `delta` is actually on PATH, so a machine
# without it keeps working with the stock pager.
#
# Colours follow the same Gruvbox Dark palette the rest of the dotfiles use
# (bg #282828 / bg1 #3c3836 / fg #ebdbb2 / gray #928374, accents red #fb4934,
# green #b8bb26, yellow #fabd2f, blue #83a598, purple #d3869b).

# NOTE: this file is intentionally platform-neutral and does NOT set core.pager,
# because the pager command differs per platform (the wrapper is invoked through
# `sh`, which resolves to Git for Windows' sh on Windows and /bin/sh on Linux).
# Each installer sets it instead:
#     install.sh      -> core.pager = sh $HOME/dotfiles/bin/delta-pager
#     windows/install.ps1 -> the same value

[interactive]
	diffFilter = delta --color-only

[delta]
	# --- Layout ---------------------------------------------------------
	# side-by-side is deliberately NOT set here: it is decided per invocation by
	# bin/delta-pager, so a narrow terminal falls back to a readable unified diff
	# instead of two truncated ~40-char columns.
	line-numbers = true
	navigate = true
	true-color = auto

	# Terminal is always dark (Gruvbox). Declaring it skips delta's OSC 10/11
	# background probe at startup, which otherwise queries the terminal on every
	# single invocation.
	dark = true

	# Syntax highlighting: bat's Gruvbox Dark theme, matching the prompt/terminal.
	syntax-theme = gruvbox-dark

	# --- Diff body ------------------------------------------------------
	# `syntax <bg>` keeps the language highlighting for the text and only sets a
	# Gruvbox-tinted background, so deletions/insertions stay readable.
	minus-style = "syntax #3c2020"
	minus-emph-style = "syntax #6b2f2f"
	minus-empty-line-marker-style = "normal #3c2020"
	plus-style = "syntax #1e2d20"
	plus-emph-style = "syntax #3d5c2a"
	plus-empty-line-marker-style = "normal #1e2d20"
	zero-style = syntax

	# --- Structure ------------------------------------------------------
	file-style = "#fabd2f bold"
	file-decoration-style = "#fabd2f ul"
	hunk-header-style = "file line-number"
	hunk-header-decoration-style = "blue box"

	# --- Gutter ---------------------------------------------------------
	line-numbers-left-style = "#928374"
	line-numbers-right-style = "#928374"
	line-numbers-minus-style = "#fb4934"
	line-numbers-plus-style = "#b8bb26"
	line-numbers-zero-style = "#504945"

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default
